---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title="Contact">
  <div class="page">
    <h1>Contact</h1>
    <p class="contact-lead">撮影のご依頼・お見積もりなど、お気軽にご連絡ください。<br />メールまたは Instagram の DM で受け付けています。</p>

    <dl class="contact-list">
      <div>
        <dt>Mail</dt>
        <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
      </div>
      <div>
        <dt>Instagram</dt>
        <dd><a href={site.instagram} target="_blank" rel="noopener">@{site.instagramId}</a></dd>
      </div>
    </dl>
  </div>
</Base>
