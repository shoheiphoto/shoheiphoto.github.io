---
import { Image } from 'astro:assets';
import type { Photo } from '../lib/works';

interface Props {
  photo: Photo;
  index: number;
  title: string;
  layout: 'stack' | 'grid' | 'rows';
}
const { photo, index, title, layout } = Astro.props;
const isPortrait = photo.image.height > photo.image.width;
// rows で横幅の配分に使う縦横比。flex-grow の合計が1未満だと横幅いっぱいに広がらないため100倍しておく
const ratio = Math.round((photo.image.width / photo.image.height) * 100);
const sizes = {
  stack: '(max-width: 1200px) 100vw, 1200px',
  grid: '(max-width: 760px) 100vw, 600px',
  rows: '(max-width: 760px) 50vw, 600px',
}[layout];
---
<li class="fade" style={`order:${index};--ratio:${ratio}`}>
  <button type="button" data-index={index} aria-label={`${index + 1}枚目を拡大表示`}>
    <Image
      src={photo.image}
      alt={`${title}（${index + 1}）`}
      widths={[640, 1080, 1600, 2000]}
      sizes={sizes}
      class={isPortrait ? 'portrait' : 'landscape'}
      loading={index < 2 ? 'eager' : 'lazy'}
    />
  </button>
</li>
